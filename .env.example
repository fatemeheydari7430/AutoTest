# ---- Environment selection ----
ENV=staging

# ---- App URLs ----
WEB_BASE_URL=https://alpha-app.lookinsure.com
API_BASE_URL=https://alpha-api.lookinsure.com

# ---- API settings ----
API_TIMEOUT=30000

# ---- Authentication (OTP flow) ----
# mobile number used for testing (no country code)
AUTH_MOBILE=528888888
# fixed OTP accepted by the backend in test env (four 1s)
AUTH_OTP=1111
# send-otp endpoint (relative to API_BASE_URL) — JSON body
AUTH_SENDOTP_ENDPOINT=/user/auth/sms/send
# login endpoint (relative to API_BASE_URL) — multipart formdata (otp, mobile)
AUTH_LOGIN_ENDPOINT=/user/auth/login
# JSON property holding the JWT in the login response (use dotted path if nested, e.g. data.accessToken)
AUTH_TOKEN_PROPERTY=response.access_token
# localStorage key where the React app stores the token (for E2E storageState)
AUTH_STORAGE_KEY=accessToken

# ---- Health check (Spring Boot actuator) — leave empty to skip ----
# HEALTH_URL=https://alpha-api.lookinsure.com/actuator/health
HEALTH_URL=

# ---- Protected user-profile endpoint (for profile.spec) — leave empty to skip ----
# e.g. /user/me
PROFILE_ENDPOINT=

# ---- Resource under test (CRUD/validation templates) — leave empty + RESOURCE_ENABLED=false to skip ----
API_RESOURCE_ENDPOINT=
API_RESOURCE_ID_PROPERTY=id
RESOURCE_ENABLED=false